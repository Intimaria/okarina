# direnv: activa asdf y descifra los secretos del repo.
#
# SOPS_AGE_KEY_FILE apunta a la clave privada de ESTE repo (una por cliente).
# La clave pública está en .sops.yaml (recipient para cifrar).

use asdf

export SOPS_AGE_KEY_FILE="$PWD/.age/keys.txt"

secrets_file="secrets.enc.yaml"
if [ -f "$secrets_file" ] && grep -q '^sops:' "$secrets_file" 2>/dev/null; then
  eval "$(sops --decrypt --output-type dotenv "$secrets_file" | sed 's/^/export /')"
  watch_file "$secrets_file"
else
  log_status "secrets.enc.yaml no cifrado todavía — salteando descifrado"
fi
